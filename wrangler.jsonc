{
  "name": "stsswb",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-20",
  "previews": {},
  "observability": {"enabled": true},
  "vars": {"SYNC_REPO": "dupirou/ssts_wb", "SYNC_WORKFLOW": "sync.yml"},
  // Wrangler 4 automatically provisions this KV namespace on first deployment.
  "kv_namespaces": [{"binding": "SYNC_HEALTH_KV"}],
  // Every 10 minutes; the Worker decides: 10-min syncs around racing sessions, hourly otherwise in race windows.
  "triggers": {"crons": ["*/10 * * * *"]},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/internal/*"]
  }
}
