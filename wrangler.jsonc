{
  "name": "stsswb",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-20",
  "previews": {},
  // Every 10 minutes; the Worker only dispatches the GitHub sync during race windows.
  "triggers": {"crons": ["*/10 * * * *"]},
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
